<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Brand Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#334155"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="🟢 SECURE INCIDENT TERMINAL"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="D-Connect Logo"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D-Connect"
                android:textColor="#F8FAFC"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disaster Management Coordination App"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Role Selector Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <RadioGroup
                android:id="@+id/roleRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/roleUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="👤 User"
                    android:textColor="#F8FAFC"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/roleVolunteer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🦺 Volunteer"
                    android:textColor="#F8FAFC"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/roleNgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 NGO"
                    android:textColor="#F8FAFC"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/roleGov"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏛️ Government"
                    android:textColor="#F8FAFC"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/roleAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Admin"
                    android:textColor="#F8FAFC" />
            </RadioGroup>
        </HorizontalScrollView>

        <!-- Dynamic Role Context Hint Badge -->
        <TextView
            android:id="@+id/textRoleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#334155"
            android:padding="10dp"
            android:text="👤 Citizen Reporting &amp; Public Safety Network"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Login Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Phone Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number *"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editLoginPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter 10-digit phone number"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:inputType="phone"
                android:maxLength="10"
                android:background="#334155"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Password Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password *"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your password"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:inputType="textPassword"
                android:background="#334155"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Login Button -->
            <Button
                android:id="@+id/btnLoginSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#10B981"
                android:padding="14dp"
                android:text="LOGIN ➔"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Register Link -->
        <TextView
            android:id="@+id/textRegisterLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New to D-Connect? Register Now"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
