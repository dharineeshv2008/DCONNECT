<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Browser GPS Geolocation Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/textGpsStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 Device GPS Location: 13.0827, 80.2707"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshGps"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#334155"
            android:text="Refresh GPS"
            android:textColor="#38BDF8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Filters Header Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 Active Incidents &amp; Disaster Pipeline"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerTypeFilter"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#334155"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/spinnerStatusFilter"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#334155" />
        </LinearLayout>
    </LinearLayout>

    <!-- Incidents RecyclerView / List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDisasters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/textEmptyDisasters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="No active incidents match the current filters."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
