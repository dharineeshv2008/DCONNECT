<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Form Card: Provide Emergency Resources -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Provide Emergency Resources"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resource Category *"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerResCategory"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="#334155"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description / Details *"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editResDescription"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="e.g. 500 Ready-to-eat Packets, clean &amp; sealed"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:gravity="top|start"
                android:background="#334155"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/editResQty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Quantity (e.g. 500)"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:inputType="number"
                    android:background="#334155"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/editResUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Unit (e.g. packets)"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:background="#334155"
                    android:padding="10dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup Address *"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editResAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Relief Warehouse Gate 3, Central Stadium"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:background="#334155"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnSubmitResource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0284C7"
                android:padding="12dp"
                android:text="ADD TO SUPPLY POOL"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Supply Pool List Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 Available Supplies in Emergency Pool"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerResources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/textEmptyResources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="No emergency supplies offered yet."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
