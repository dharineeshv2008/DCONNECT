<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/itemTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#0284C7"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="FLOOD"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#059669"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="VERIFIED ACTIVE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/itemMergedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗 1 Report"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Flash Flooding at North Bridge"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/itemLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Near Gandhi Circle, Sector 4 (13.0827, 80.2707)"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/itemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Water level rising rapidly. Trapped persons require boat evacuation."
        android:textColor="#CBD5E1"
        android:textSize="13sp"
        android:maxLines="3"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/itemReporterInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reported by Citizen User • 10 mins ago"
        android:textColor="#64748B"
        android:textSize="11sp" />

</LinearLayout>
