<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 Register D-Connect Account"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Role Select -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Role *"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerRegRole"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#334155"
            android:layout_marginBottom="10dp" />

        <!-- Name -->
        <EditText
            android:id="@+id/editRegName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name *"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:background="#334155"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Phone -->
        <EditText
            android:id="@+id/editRegPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number (10 digits) *"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:inputType="phone"
            android:maxLength="10"
            android:background="#334155"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Password -->
        <EditText
            android:id="@+id/editRegPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password (min 6 chars) *"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:inputType="textPassword"
            android:background="#334155"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Organization Name -->
        <EditText
            android:id="@+id/editRegOrgName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Organization Name (for NGO/Gov)"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:background="#334155"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Organization Reg No -->
        <EditText
            android:id="@+id/editRegOrgNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Registration Number (for NGO/Gov)"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:background="#334155"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Volunteer Skills -->
        <EditText
            android:id="@+id/editRegSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Volunteer Skills (e.g. First Aid, Swimming)"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:background="#334155"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#10B981"
            android:padding="12dp"
            android:text="CREATE ACCOUNT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
